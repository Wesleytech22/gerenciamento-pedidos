{
  "info": {
    "name": "API de Gerenciamento de Pedidos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "baseUrl", "value": "http://localhost:3000" }],
  "item": [
    {
      "name": "01 - Criar pedido (201)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/pedidos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cliente\": \"Carlos Silva\",\n  \"tipo\": \"entrega\",\n  \"valor\": 350,\n  \"prioridade\": \"normal\"\n}"
        }
      }
    },
    {
      "name": "02 - Criar pedido inválido (400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/pedidos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cliente\": \"   \",\n  \"tipo\": \"drone\",\n  \"valor\": -5,\n  \"prioridade\": \"normal\"\n}"
        }
      }
    },
    {
      "name": "03 - Listar pedidos (200)",
      "request": { "method": "GET", "url": "{{baseUrl}}/pedidos" }
    },
    {
      "name": "04 - Consultar pedido inexistente (404)",
      "request": { "method": "GET", "url": "{{baseUrl}}/pedidos/999" }
    },
    {
      "name": "05 - Atualizar status (200)",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/pedidos/1/status",
        "body": { "mode": "raw", "raw": "{\n  \"status\": \"em_preparacao\"\n}" }
      }
    },
    {
      "name": "Consultar pedido existente (200)",
      "request": { "method": "GET", "url": "{{baseUrl}}/pedidos/1" }
    },
    {
      "name": "Transição inválida (400)",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/pedidos/1/status",
        "body": { "mode": "raw", "raw": "{\n  \"status\": \"recebido\"\n}" }
      }
    }
  ]
}
